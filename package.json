{
  "name": "opencode-auth-pool",
  "version": "0.0.0",
  "description": "OpenCode plugin foundation for multi-account provider management.",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "license": "MIT",
  "main": "./dist/server/index.js",
  "types": "./dist/server/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./tui": {
      "types": "./dist/tui/index.d.ts",
      "default": "./dist/tui/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "opencode:sandbox": "node scripts/opencode-sandbox.mjs"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.14.32",
    "better-sqlite3": "^12.10.0"
  },
  "devDependencies": {
    "@opentui/core": "^0.2.2",
    "@opentui/solid": "^0.2.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "solid-js": "^1.9.10",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
