{
  "name": "opencode-auth-pool",
  "version": "0.0.0",
  "description": "OpenCode plugin foundation for multi-account provider management.",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "license": "MIT",
  "main": "./dist/server/index.js",
  "types": "./dist/server/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./tui": {
      "types": "./dist/tui/index.d.ts",
      "default": "./dist/tui/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "test": "bun run build && bun run test:unit",
    "test:unit": "bun test ./test",
    "test:e2e-sandbox": "node --test e2e-sandbox/test/*.test.mjs",
    "opencode:sandbox": "node e2e-sandbox/opencode-sandbox.mjs"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.15.13"
  },
  "devDependencies": {
    "@opentui/core": "^0.2.10",
    "@opentui/keymap": "^0.2.10",
    "@opentui/solid": "^0.2.10",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.19.19",
    "solid-js": "^1.9.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
